# Static public-tree QA, reusing the reviewed literal registration/source check.
# Supported setters: set_tests_properties(... PROPERTIES DEPENDS "a;b") and
# set_property(TEST ... [APPEND] PROPERTY DEPENDS a b). No variable expansion,
# generator expressions, APPEND_STRING, or project-code execution is performed.
# Quoted escaped semicolons in DEPENDS identify a literal-semicolon name;
# ordinary semicolons delimit references. Owner arguments are whole names.
cmake_minimum_required(VERSION 3.16)
include("${CMAKE_CURRENT_LIST_DIR}/check_ctest_source_paths.cmake")

function(require_test_names names description allow_empty)
    if(names MATCHES "\\$|\\[|\\]")
        message(FATAL_ERROR "${description}: nonliteral test names are unsupported: ${names}")
    endif()
    foreach(name IN LISTS names)
        # CTest ignores empty entries in DEPENDS lists; owners stay strict.
        if(allow_empty AND name STREQUAL "")
            continue()
        endif()
        # A retained list escape (including an unquoted triple-backslash
        # spelling) yields one name containing a literal semicolon here.
        string(REPLACE ";" "${test_name_semicolon_marker}" identity "${name}")
        string(REPLACE "${source_semicolon_marker}" "${test_name_semicolon_marker}"
               identity "${identity}")
        if(NOT identity IN_LIST registered_test_names)
            string(REPLACE "${test_name_semicolon_marker}" ";" display_name "${identity}")
            message(FATAL_ERROR "${description}: unregistered CTest name: ${display_name}")
        endif()
    endforeach()
endfunction()

function(tokenize_depends_arguments body output)
    protect_quoted_source_semicolons("${body}" input)
    set(normalized "")
    # Literal unquoted lists expand before the setter sees its arguments.
    # Quoted tokens and escaped characters do not take part in that expansion.
    while(input MATCHES "\\\\.|\"([^\"\\\\]|\\\\.)*\"")
        set(token "${CMAKE_MATCH_0}")
        if(token MATCHES "^\"")
            # CMake accepts \t, \n and \r but rejects other alphanumeric
            # escapes. UNIX_COMMAND would silently drop their backslash.
            # Protect escaped backslash pairs before inspecting escapes.
            string(REPLACE "\\\\" "${quoted_backslash_pair_marker}" escape_check "${token}")
            string(REGEX REPLACE "\\\\[tnr]" "" escape_check "${escape_check}")
            if(escape_check MATCHES "\\\\[A-Za-z0-9]")
                message(FATAL_ERROR "invalid alphanumeric escape in literal CTest property setter: ${CMAKE_MATCH_0}")
            endif()
        endif()
        string(FIND "${input}" "${token}" token_start)
        string(SUBSTRING "${input}" 0 ${token_start} prefix)
        string(REPLACE ";" " " prefix "${prefix}")
        string(APPEND normalized "${prefix}${token}")
        string(LENGTH "${token}" token_length)
        math(EXPR token_end "${token_start} + ${token_length}")
        string(SUBSTRING "${input}" ${token_end} -1 input)
    endwhile()
    string(REPLACE ";" " " input "${input}")
    string(APPEND normalized "${input}")
    tokenize_ctest_literal_arguments("${normalized}" arguments)
    set(${output} "${arguments}" PARENT_SCOPE)
endfunction()

function(encode_depends_owner owner output)
    # As in NAME registration, quoted \; in an owner contains a backslash
    # rather than being the spelling of a plain literal-semicolon name.
    if(owner MATCHES "${source_semicolon_marker}")
        message(FATAL_ERROR "quoted escaped-semicolon DEPENDS owners are unsupported")
    endif()
    encode_ctest_name("${owner}" identity)
    set(${output} "${identity}" PARENT_SCOPE)
endfunction()

function(collect_literal_depends_setters input output)
    set(setters "")
    set(depth 0)
    # Consume complete quoted tokens and escapes before considering command
    # heads. Parentheses inside another command's arguments are data here.
    # The source lexer has already protected quoted/escaped right parentheses.
    while(input MATCHES "\\\\.|\"([^\"\\\\]|\\\\.)*\"|\\[=*\\[|[A-Za-z_][A-Za-z_0-9]*[ \t\r\n]*\\(|[()]")
        set(token "${CMAKE_MATCH_0}")
        string(FIND "${input}" "${token}" start)
        string(SUBSTRING "${input}" 0 ${start} prefix)
        string(LENGTH "${token}" length)
        math(EXPR after_token "${start} + ${length}")
        string(SUBSTRING "${input}" ${after_token} -1 input)
        if(token MATCHES "^\\[(=*)\\[")
            set(bracket_close "]${CMAKE_MATCH_1}]")
            if(prefix MATCHES "(^|[ \t\r\n(])$")
                string(FIND "${input}" "${bracket_close}" close_start)
                if(close_start LESS 0)
                    message(FATAL_ERROR "unterminated CMake bracket data in DEPENDS scan")
                endif()
                string(LENGTH "${bracket_close}" close_length)
                math(EXPR after_bracket "${close_start} + ${close_length}")
                string(SUBSTRING "${input}" ${after_bracket} -1 input)
            endif()
            continue()
        endif()
        if(token MATCHES "^\"" OR token MATCHES "^\\\\")
            continue()
        endif()
        if(depth EQUAL 0 AND token MATCHES "^(set_tests_properties|set_property)[ \t\r\n]*\\($")
            if(NOT input MATCHES "^([^)]*)\\)")
                message(FATAL_ERROR "unterminated literal CTest property setter")
            endif()
            set(body "${CMAKE_MATCH_0}")
            string(APPEND setters "${token}${body}\n")
            string(LENGTH "${body}" length)
            string(SUBSTRING "${input}" ${length} -1 input)
        elseif(token MATCHES "\\($")
            math(EXPR depth "${depth} + 1")
        elseif(token STREQUAL ")")
            math(EXPR depth "${depth} - 1")
        endif()
    endwhile()
    set(${output} "${setters}" PARENT_SCOPE)
endfunction()

collect_literal_depends_setters("${declarations}" literal_depends_declarations)
set(setter_count 0)
set(remaining "${literal_depends_declarations}")
# Consume one command at a time: MATCHALL/foreach would split quoted semicolon
# lists before separate_arguments can preserve them as a single property value.
while(remaining MATCHES "(^|[^A-Za-z0-9_])(set_tests_properties|set_property)[ \t\r\n]*\\(([^)]*)\\)")
    set(setter "${CMAKE_MATCH_2}")
    set(body "${CMAKE_MATCH_3}")
    set(matched "${CMAKE_MATCH_0}")
    string(FIND "${remaining}" "${matched}" start)
    string(LENGTH "${matched}" length)
    math(EXPR end "${start} + ${length}")
    string(SUBSTRING "${remaining}" ${end} -1 remaining)
    # Preserve quoted \; before UNIX_COMMAND removes that CMake list escape.
    # The existing source helper supplies a reserved, collision-checked marker.
    tokenize_depends_arguments("${body}" arguments)

    if(setter STREQUAL "set_tests_properties")
        list(FIND arguments PROPERTIES properties_index)
        if(properties_index LESS 1)
            message(FATAL_ERROR "unsupported literal set_tests_properties call")
        endif()
        math(EXPR values_index "${properties_index} + 1")
        list(LENGTH arguments argument_count)
        math(EXPR property_count "${argument_count} - ${values_index}")
        math(EXPR odd_count "${property_count} % 2")
        if(property_count LESS 2 OR odd_count)
            message(FATAL_ERROR "set_tests_properties requires property/value pairs")
        endif()
        # Keep indices into the original token list. Copying a sublist loses
        # escaping around quoted semicolons and changes property/value pairing.
        while(values_index LESS argument_count)
            list(GET arguments ${values_index} property)
            math(EXPR value_index "${values_index} + 1")
            list(GET arguments ${value_index} value)
            if(property STREQUAL "DEPENDS")
                set(owners)
                set(owner_index 0)
                while(owner_index LESS properties_index)
                    list(GET arguments ${owner_index} owner)
                    encode_depends_owner("${owner}" owner_identity)
                    list(APPEND owners "${owner_identity}")
                    math(EXPR owner_index "${owner_index} + 1")
                endwhile()
                require_test_names("${owners}" "DEPENDS owner" FALSE)
                require_test_names("${value}" "DEPENDS reference" TRUE)
                math(EXPR setter_count "${setter_count} + 1")
            endif()
            math(EXPR values_index "${values_index} + 2")
        endwhile()
    else()
        list(GET arguments 0 scope)
        if(NOT scope STREQUAL "TEST")
            continue()
        endif()
        list(FIND arguments PROPERTY property_index)
        if(property_index LESS 2)
            message(FATAL_ERROR "unsupported literal set_property(TEST) call")
        endif()
        math(EXPR property_name_index "${property_index} + 1")
        list(GET arguments ${property_name_index} property)
        if(NOT property STREQUAL "DEPENDS")
            continue()
        endif()
        set(owners)
        set(owner_index 1)
        while(owner_index LESS property_index)
            list(GET arguments ${owner_index} owner)
            if(owner STREQUAL "APPEND_STRING")
                message(FATAL_ERROR "DEPENDS APPEND_STRING is unsupported")
            elseif(NOT owner STREQUAL "APPEND")
                encode_depends_owner("${owner}" owner_identity)
                list(APPEND owners "${owner_identity}")
            endif()
            math(EXPR owner_index "${owner_index} + 1")
        endwhile()
        # Registered names such as OFF, FALSE and 0 are not empty owner lists.
        list(LENGTH owners owner_count)
        if(owner_count EQUAL 0)
            message(FATAL_ERROR "DEPENDS setter has no test owner")
        endif()
        math(EXPR values_index "${property_name_index} + 1")
        list(LENGTH arguments argument_count)
        require_test_names("${owners}" "DEPENDS owner" FALSE)
        while(values_index LESS argument_count)
            list(GET arguments ${values_index} value)
            require_test_names("${value}" "DEPENDS reference" TRUE)
            math(EXPR values_index "${values_index} + 1")
        endwhile()
        math(EXPR setter_count "${setter_count} + 1")
    endif()
endwhile()
message(STATUS "Checked ${setter_count} literal CTest DEPENDS setters")
