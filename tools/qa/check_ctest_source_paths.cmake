# Lightweight static check for this project's literal top-level registrations.
# Deliberately rejects unsupported forms rather than silently omitting a test.
cmake_minimum_required(VERSION 3.16)

if(NOT DEFINED POOLRAD_SOURCE_ROOT)
    get_filename_component(POOLRAD_SOURCE_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
endif()
file(READ "${POOLRAD_SOURCE_ROOT}/CMakeLists.txt" declarations)
string(REGEX REPLACE "#[^\n]*" "" declarations "${declarations}")
string(REGEX MATCHALL "add_(executable|test)[ \t\r\n]*\\([^)]*\\)"
       registrations "${declarations}")

function(require_source path test_name)
    string(REPLACE "\${CMAKE_CURRENT_SOURCE_DIR}" "${POOLRAD_SOURCE_ROOT}" path "${path}")
    if(path MATCHES "\\$" OR path MATCHES ";")
        message(FATAL_ERROR "${test_name}: unsupported source expression: ${path}")
    endif()
    if(NOT IS_ABSOLUTE "${path}")
        set(path "${POOLRAD_SOURCE_ROOT}/${path}")
    endif()
    if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
        message(FATAL_ERROR "${test_name}: missing registered test source: ${path}")
    endif()
endfunction()

# Collect executable definitions first, so registration order is immaterial.
foreach(registration IN LISTS registrations)
    if(registration MATCHES "^add_executable[ \t\r\n]*\\((.*)\\)$")
        separate_arguments(arguments UNIX_COMMAND "${CMAKE_MATCH_1}")
        list(POP_FRONT arguments target)
        if(DEFINED "test_sources_${target}")
            message(FATAL_ERROR "duplicate executable definition: ${target}")
        endif()
        set("test_sources_${target}" "${arguments}")
    endif()
endforeach()

set(test_count 0)
set(source_count 0)
foreach(registration IN LISTS registrations)
    if(NOT registration MATCHES "^add_test[ \t\r\n]*\\((.*)\\)$")
        continue()
    endif()
    separate_arguments(arguments UNIX_COMMAND "${CMAKE_MATCH_1}")
    list(LENGTH arguments argument_count)
    if(argument_count LESS 4)
        message(FATAL_ERROR "unsupported add_test registration: ${registration}")
    endif()
    list(POP_FRONT arguments name_keyword test_name command_keyword command)
    if(NOT name_keyword STREQUAL "NAME" OR NOT command_keyword STREQUAL "COMMAND")
        message(FATAL_ERROR "${test_name}: expected add_test(NAME ... COMMAND ...)")
    endif()
    if(DEFINED "test_sources_${command}")
        set(sources "${test_sources_${command}}")
        foreach(source IN LISTS sources)
            if(source STREQUAL "WIN32" OR source STREQUAL "MACOSX_BUNDLE" OR
               source STREQUAL "EXCLUDE_FROM_ALL")
                continue()
            endif()
            require_source("${source}" "${test_name}")
            math(EXPR source_count "${source_count} + 1")
        endforeach()
        if(NOT sources)
            message(FATAL_ERROR "${test_name}: executable has no source paths")
        endif()
    elseif(command STREQUAL "\${CMAKE_COMMAND}" OR command STREQUAL "${CMAKE_COMMAND}")
        list(FIND arguments "-P" script_flag)
        if(script_flag LESS 0)
            message(FATAL_ERROR "${test_name}: expected a CMake -P script source")
        endif()
        math(EXPR script_index "${script_flag} + 1")
        list(LENGTH arguments argument_count)
        if(script_index GREATER_EQUAL argument_count)
            message(FATAL_ERROR "${test_name}: CMake -P script source is missing")
        endif()
        list(GET arguments ${script_index} script)
        require_source("${script}" "${test_name}")
        math(EXPR source_count "${source_count} + 1")
    else()
        message(FATAL_ERROR "${test_name}: no executable source definition for ${command}")
    endif()
    math(EXPR test_count "${test_count} + 1")
endforeach()
if(test_count EQUAL 0)
    message(FATAL_ERROR "no supported CTest registrations found")
endif()
message(STATUS "Checked ${test_count} CTest registrations and ${source_count} source paths")
