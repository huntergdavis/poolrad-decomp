# Same bounded literal syntax and canonical identities as the reference validator.
# Repeated edges are legal in CTest; only self/indirect cycles are rejected.
cmake_minimum_required(VERSION 3.16)
include("${CMAKE_CURRENT_LIST_DIR}/check_ctest_depends.cmake")

function(record_edges owners dependencies append)
    set(normalized_dependencies)
    foreach(dependency IN LISTS dependencies)
        if(dependency STREQUAL "")
            continue()
        endif()
        string(REPLACE "${source_semicolon_marker}" "${test_name_semicolon_marker}"
               dependency "${dependency}")
        list(APPEND normalized_dependencies "${dependency}")
    endforeach()
    foreach(owner IN LISTS owners)
        if(append)
            set(edges "${graph_${owner}}")
            list(APPEND edges ${normalized_dependencies})
        else()
            set(edges "${normalized_dependencies}")
        endif()
        list(REMOVE_DUPLICATES edges)
        set("graph_${owner}" "${edges}" PARENT_SCOPE)
    endforeach()
endfunction()

# Reference validation above has checked owners, values and supported setters.
# Replay literal property assignments in order to avoid false cycles from an
# overwritten or explicitly cleared earlier dependency list.
set(remaining "${literal_depends_declarations}")
while(remaining MATCHES "(^|[^A-Za-z0-9_])(set_tests_properties|set_property)[ \t\r\n]*\\(([^)]*)\\)")
    set(setter "${CMAKE_MATCH_2}")
    set(body "${CMAKE_MATCH_3}")
    set(matched "${CMAKE_MATCH_0}")
    string(FIND "${remaining}" "${matched}" start)
    string(LENGTH "${matched}" length)
    math(EXPR after_match "${start} + ${length}")
    string(SUBSTRING "${remaining}" ${after_match} -1 remaining)
    tokenize_depends_arguments("${body}" arguments)
    if(setter STREQUAL "set_tests_properties")
        list(FIND arguments PROPERTIES properties_index)
        math(EXPR property_index "${properties_index} + 1")
        list(LENGTH arguments argument_count)
        while(property_index LESS argument_count)
            list(GET arguments ${property_index} property)
            math(EXPR value_index "${property_index} + 1")
            list(GET arguments ${value_index} value)
            if(property STREQUAL "DEPENDS")
                set(owners)
                set(owner_index 0)
                while(owner_index LESS properties_index)
                    list(GET arguments ${owner_index} owner)
                    encode_depends_owner("${owner}" identity)
                    list(APPEND owners "${identity}")
                    math(EXPR owner_index "${owner_index} + 1")
                endwhile()
                record_edges("${owners}" "${value}" FALSE)
            endif()
            math(EXPR property_index "${property_index} + 2")
        endwhile()
    else()
        list(GET arguments 0 scope)
        if(NOT scope STREQUAL "TEST")
            continue()
        endif()
        list(FIND arguments PROPERTY property_index)
        math(EXPR property_name_index "${property_index} + 1")
        list(GET arguments ${property_name_index} property)
        if(NOT property STREQUAL "DEPENDS")
            continue()
        endif()
        set(owners)
        set(append FALSE)
        set(owner_index 1)
        while(owner_index LESS property_index)
            list(GET arguments ${owner_index} owner)
            if(owner STREQUAL "APPEND")
                set(append TRUE)
            else()
                encode_depends_owner("${owner}" identity)
                list(APPEND owners "${identity}")
            endif()
            math(EXPR owner_index "${owner_index} + 1")
        endwhile()
        math(EXPR values_index "${property_name_index} + 1")
        list(LENGTH arguments argument_count)
        set(dependencies)
        while(values_index LESS argument_count)
            list(GET arguments ${values_index} value)
            list(APPEND dependencies "${value}")
            math(EXPR values_index "${values_index} + 1")
        endwhile()
        record_edges("${owners}" "${dependencies}" "${append}")
    endif()
endwhile()

foreach(owner IN LISTS registered_test_names)
    if(owner IN_LIST graph_${owner})
        string(REPLACE "${test_name_semicolon_marker}" ";" display_owner "${owner}")
        message(FATAL_ERROR "self CTest DEPENDS reference: ${display_owner}")
    endif()
endforeach()
set(pending "${registered_test_names}")
while(pending)
    set(progress FALSE)
    foreach(owner IN LISTS pending)
        set(blocked FALSE)
        foreach(dependency IN LISTS graph_${owner})
            if(dependency IN_LIST pending)
                set(blocked TRUE)
                break()
            endif()
        endforeach()
        if(NOT blocked)
            list(REMOVE_ITEM pending "${owner}")
            set(progress TRUE)
        endif()
    endforeach()
    if(NOT progress)
        set(display_pending "")
        foreach(owner IN LISTS pending)
            string(REPLACE "${test_name_semicolon_marker}" ";" display_owner "${owner}")
            string(APPEND display_pending " [${display_owner}]")
        endforeach()
        message(FATAL_ERROR "CTest DEPENDS cycle leaves blocked tests:${display_pending}")
    endif()
endwhile()
message(STATUS "Literal CTest DEPENDS graph is acyclic; repeated edges accepted")
