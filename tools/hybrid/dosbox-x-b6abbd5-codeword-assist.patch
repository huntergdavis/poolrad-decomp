+/* ASSIST: code-word prompt, assisted input, emulator side. Not parity evidence.
+ * Plan: docs/HYBRID_CODEWORD_ASSIST.md. The Python reader and gate (tools/hybrid/codeword_assist.py) are the spec; the
+ * C++ below must produce the same transcripts (tests/hybrid/test_codeword_assist_conformance.py).
+ * Off unless POOLRAD_CODEWORD_ASSIST=1. Decisions are logged to POOLRAD_CODEWORD_ASSIST_LOG when that is set. */
+#ifndef POOLRAD_PR_CODEWORD_ASSIST_H
+#define POOLRAD_PR_CODEWORD_ASSIST_H
+
+#include <array>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <set>
+#include <string>
+#include <utility>
+#include <vector>
