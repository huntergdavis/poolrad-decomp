+#ifdef PR_CA_DOSBOX
+/* ---- DOSBox-X glue: emulator memory, the printer-call record, the keyboard poll and the single key send ---- */
+#include "keyboard.h"
+#include "mem.h"
+#include "paging.h"
+#include "regs.h"
+
+namespace pr_ca {
+
+struct State {
+    bool inited = false;
+    bool on = false;
+    Gate *gate = NULL;
+    FILE *log = NULL;
+    std::vector<std::pair<uint16_t, uint16_t> > printer_calls;  /* (cs, ip) of 0709:0626 calls since the last clearing poll (see poll_hook for the exact rule) */
+    std::string last_silent;
+    unsigned long long polls = 0, silent = 0, sends = 0;
+};
+
+inline State &st() {
+    static State s;
+    return s;
+}
+
+inline void log_line(const char *what, const char *detail) {
+    State &s = st();
+    if (!s.log) return;
+    fprintf(s.log, "%s %s %s\n", kLabel, what, detail);
+    fflush(s.log);
+}
+
+inline void init() {
+    State &s = st();
+    s.inited = true;
+    const char *on = getenv("POOLRAD_CODEWORD_ASSIST");
+    s.on = on != NULL && on[0] == '1' && on[1] == 0;
+    if (!s.on) return;
+    s.gate = new Gate(true);
+    const char *lg = getenv("POOLRAD_CODEWORD_ASSIST_LOG");
+    if (lg && lg[0]) s.log = fopen(lg, "a");
+    log_line("init", "enabled");
+}
+
+/* The emulator's own memory, read through the CPU's current segments. */
+class DosMem : public Mem {
+public:
+    bool ss_word(uint16_t off, uint16_t &v) override { v = mem_readw(SegPhys(ss) + off); return true; }
+    bool ss_byte(uint16_t off, uint8_t &v) override { v = mem_readb_inline(SegPhys(ss) + off); return true; }
+    bool ds_table(uint8_t *out) override {
+        PhysPt base = SegPhys(ds);
+        for (int i = 0; i < kTableBytes; ++i) out[i] = mem_readb_inline(base + (uint32_t)i);
+        return true;
+    }
+};
+
+/* At an instruction of 0709:0626 (printer entry) record the caller: the far call has just pushed IP, then CS. */
+inline void check_ip(uint16_t cs, uint16_t ip) {
+    State &s = st();
+    if (cs != kRes0709Seg) return;
+    if (ip == kPrintIp) {
+        uint16_t ret_ip = mem_readw(SegPhys(ss) + (uint16_t)reg_sp);
+        uint16_t ret_cs = mem_readw(SegPhys(ss) + (uint16_t)(reg_sp + 2));
+        if (s.printer_calls.size() >= (size_t)kPrinterCap) s.printer_calls.erase(s.printer_calls.begin());
+        s.printer_calls.push_back(std::make_pair(ret_cs, ret_ip));
+    }
+}
+
+inline KBD_KEYS kbd_for(const std::string &key) {
+    static const KBD_KEYS letters[26] = {KBD_a, KBD_b, KBD_c, KBD_d, KBD_e, KBD_f, KBD_g, KBD_h, KBD_i, KBD_j, KBD_k, KBD_l, KBD_m,
+                                         KBD_n, KBD_o, KBD_p, KBD_q, KBD_r, KBD_s, KBD_t, KBD_u, KBD_v, KBD_w, KBD_x, KBD_y, KBD_z};
+    if (key == kReturnKey) return KBD_enter;
+    return letters[key[0] - 'A'];
+}
+
+/* Called from INT 16h AH=00/01 (the keyboard poll). One normal keystroke per SEND: make, then break. */
+inline void poll_hook() {
+    State &s = st();
+    ++s.polls;
+    Snap snap;
+    snap.bp = reg_bp;
+    snap.bda_head = mem_readw(0x41A);
+    snap.bda_tail = mem_readw(0x41C);
+    snap.keyboard_poll = true;
+    snap.printer_calls = s.printer_calls;
+    DosMem m;
+    Action a = s.gate->step(snap, m);
+    if (a.reason == "no-unique-input-return" || a.reason == "no-input-routine-child" || a.reason == "input-routine-chain-mismatch")
+        s.printer_calls.clear();
+    if (a.kind == "SEND") {
+        ++s.sends;
+        KBD_KEYS k = kbd_for(a.key);
+        KEYBOARD_AddKey(k, true);
+        KEYBOARD_AddKey(k, false);
+        log_line("SEND", a.key.c_str());
+        s.last_silent.clear();
+    } else if (a.kind == "WAIT") {
+        s.last_silent.clear();
+    } else {
+        ++s.silent;
+        if (a.reason != s.last_silent) {
+            log_line("SILENT", a.reason.c_str());
+            s.last_silent = a.reason;
+        }
+    }
+}
