+/* Macros used by the core loop and the INT 16h handler. Both are no-ops until init(), and off unless enabled. */
+#define PR_CODEWORD_ASSIST_OBSERVE() do { \
+    if (!pr_ca::st().inited) pr_ca::init(); \
+    if (pr_ca::st().on && !cpu.pmode) { uint16_t _ca_ip = (uint16_t)reg_eip; \
+        if (_ca_ip == pr_ca::kPrintIp || _ca_ip == pr_ca::kInputIp) pr_ca::check_ip(SegValue(cs), _ca_ip); } } while (0)
+#define PR_CODEWORD_ASSIST_POLL() do { \
+    if (!pr_ca::st().inited) pr_ca::init(); \
+    if (pr_ca::st().on && (reg_ah == 0x00 || reg_ah == 0x01)) pr_ca::poll_hook(); } while (0)
+
+#else
+#define PR_CODEWORD_ASSIST_OBSERVE() do { } while (0)
+#define PR_CODEWORD_ASSIST_POLL() do { } while (0)
+#endif
+
