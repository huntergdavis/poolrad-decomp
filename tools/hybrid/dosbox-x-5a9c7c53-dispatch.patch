+    if (memcmp(before, &e.before, sizeof *before) != 0) {
+        static const char *nm[14] = {"AX","BX","CX","DX","SI","DI","BP","SP","CS","IP","DS","ES","SS","FLAGS"};
+        const uint16_t *cw = (const uint16_t *)before, *ow = (const uint16_t *)&e.before;
+        std::string d; char w[40];
+        for (int k = 0; k < 14; ++k) if (cw[k] != ow[k]) { snprintf(w, sizeof w, " %s C=%04X orig=%04X", nm[k], cw[k], ow[k]); d += w; }
+        snprintf(buf, sizeof buf, "service %u (AX=%04X IP=%04X) differs at the INT:", (unsigned)svc_cursor, before->ax, before->ip);
+        svc_mismatch = std::string(buf) + d; return 1;
+    }
+    for (size_t k = 0; k < e.delta.size(); ++k) MemBase[e.delta[k].first] = e.delta[k].second;
+    *after = e.after; ++svc_cursor; return 0;
+}
+static int svc_open(void *ctx, const pr_reset_cpu *b, pr_reset_cpu *a) { (void)ctx; return svc_replay((const Cpu14 *)b, (Cpu14 *)a); }
+static int svc_close(void *ctx, const pr_system_close_cpu *b, pr_system_close_cpu *a) { (void)ctx; return svc_replay((const Cpu14 *)b, (Cpu14 *)a); }
+/* BlockRead hands the service a STAGING copy of DS:DX and writes it back over RAM afterwards, so the read bytes must reach
+ * the staging buffer: after the replay applies the recorded RAM delta, copy the destination from RAM into it. */
+static int svc_read(void *ctx, const pr_blockread_cpu *b, pr_blockread_cpu *a, uint8_t *buf, size_t len) {
+    (void)ctx;
+    if (svc_replay((const Cpu14 *)b, (Cpu14 *)a) != 0) return 1;
+    size_t base = ((size_t)b->ds << 4) + b->dx;
+    for (size_t k = 0; k < len; ++k) buf[k] = MemBase[(base + k) & (RAM - 1u)];
+    return 0;
+}
+static int svc_seek(void *ctx, const pr_seek_cpu *b, pr_seek_cpu *a) { (void)ctx; return svc_replay((const Cpu14 *)b, (Cpu14 *)a); }
+static int svc_filepos(void *ctx, const pr_filepos_cpu *b, pr_filepos_cpu *a) { (void)ctx; return svc_replay((const Cpu14 *)b, (Cpu14 *)a); }
+static int svc_kbd(void *ctx, const pr_crt_cpu *b, pr_crt_cpu *a) { (void)ctx; return svc_replay((const Cpu14 *)b, (Cpu14 *)a); }
+/* ReadKey's driver and quit paths (the 13h sound hotkey, the STING quit) are not on the recorded path: these refuse, so the
+ * C stops and the original's result is kept if either path is ever taken. */
+static std::string refused;
+static int no_vector(void *ctx, uint8_t *ram, pr_r08ae_driver_cpu *c, uint16_t *f) { (void)ctx; (void)ram; (void)c; (void)f; refused = "driver DOS vector"; return 1; }
+static int no_out(void *ctx, uint16_t port, uint8_t v) { (void)ctx; (void)port; (void)v; refused = "driver OUT"; return 1; }
+static int no_in(void *ctx, uint16_t port, uint8_t *v) { (void)ctx; (void)port; (void)v; refused = "driver IN"; return 1; }
+static int no_time(void *ctx, const pr_dos_gettime_cpu *b, pr_dos_gettime_cpu *a) { (void)ctx; (void)b; (void)a; refused = "GetTime"; return 1; }
+static int no_video(void *ctx, uint8_t *ram, const pr_dos_intr_cpu *b, pr_dos_intr_cpu *a) { (void)ctx; (void)ram; (void)b; (void)a; refused = "INT 10h"; return 1; }
+/* A service body at the original's return: the C runs from S with the original's DOS calls replayed; registers and all
+ * 1 MiB must equal O. On any stop (including a service mismatch) the original's result is kept: a hand-back would make DOS
+ * execute the call twice. */
+static bool svc_check(const Regs &now) {
+    Body &x = bodies[cur];
+    O = now; memcpy(&oram[0], MemBase, RAM);
+    put(S); memcpy(MemBase, &sram[0], RAM);
+    svc_cursor = 0; svc_mismatch.clear();
+    Cpu14 m = to14(S);
+    int st; uint16_t site = 0; refused.clear();
+    if (!strcmp(x.id, "RES_0802_02EB")) {
+        pr_r0802_02eb_env env = {svc_open, NULL, svc_close, NULL};
+        pr_r0802_02eb_diagnostic dg;
+        st = pr_r0802_02eb(MemBase, RAM, (pr_r0802_02eb_cpu *)&m, &env, &dg); site = dg.site;
+        st = st == PR_R0802_02EB_RETURNED ? 0 : st;
+    } else if (!strcmp(x.id, "RES_0802_025D")) {
+        pr_r0802_02eb_env env = {svc_open, NULL, svc_close, NULL};
+        pr_r0802_025d_diagnostic dg;
+        st = pr_r0802_025d(MemBase, RAM, (pr_r0802_025d_cpu *)&m, &env, 64u, &dg); site = dg.site;
+        st = st == PR_R0802_025D_RETURNED ? 0 : st;
+    } else if (!strcmp(x.id, "RES_0802_05CD")) {
+        pr_r0802_05cd_env env = {{svc_open, NULL, svc_close, NULL}, svc_read, NULL, svc_seek, NULL, 64u};
+        pr_r0802_05cd_diagnostic dg;
+        st = pr_r0802_05cd(MemBase, RAM, (pr_r0802_05cd_cpu *)&m, &env, &dg); site = dg.site;
+        st = st == PR_R0802_05CD_RETURNED ? 0 : st;
+    } else if (!strcmp(x.id, "RES_0802_0716")) {
+        /* The composed entry: 0716's eight seams run as their models (05CD, 050F, 06E7, ...). Every DOS call is replayed; the
+         * insert-disk prompt refuses (no video, no driver), so a prompt would stop the C and keep the original's result. */
+        pr_r0802_0716c_env env; memset(&env, 0, sizeof env);
+        env.loader.read = svc_read; env.loader.filepos = svc_filepos; env.loader.seek = svc_seek; env.loader.getmem_steps = 1u << 20;
+        env.file.open = svc_open; env.file.close = svc_close;
+        env.prompt.display.video = no_video;
+        env.prompt.key.quit.driver.dos_vector = no_vector; env.prompt.key.quit.driver.port_out = no_out; env.prompt.key.quit.driver.port_in = no_in;
+        env.prompt.key.quit.driver.gettime = no_time; env.prompt.key.quit.video = no_video; env.prompt.key.keyboard = svc_kbd;
+        env.prompt.key.drain_limit = 1u << 20;
+        env.heap_steps = 1u << 20; env.decode_arrivals = 1u << 24; env.retries = 64u; env.max_seams = 1u << 16; env.max_disk_prompts = 4u;
+        pr_r0802_0716c_diagnostic dg; memset(&dg, 0, sizeof dg);
+        st = pr_r0802_0716_composed(MemBase, RAM, (pr_r0802_0716c_cpu *)&m, &env, &dg); site = dg.seam;
+        st = st == PR_R0802_0716C_RETURNED ? 0 : st;
+    } else if (!strcmp(x.id, "RES_0802_06E7")) {
+        pr_r0802_06e7_diagnostic dg;
+        st = pr_r0802_06e7(MemBase, RAM, (pr_r0802_06e7_cpu *)&m, svc_close, NULL, &dg); site = dg.site;
+        st = st == PR_R0802_06E7_RETURNED ? 0 : st;
+    } else {
+        pr_r0899_key_env env;
+        memset(&env, 0, sizeof env);
+        env.quit.driver.dos_vector = no_vector; env.quit.driver.port_out = no_out; env.quit.driver.port_in = no_in;
+        env.quit.driver.gettime = no_time; env.quit.video = no_video; env.keyboard = svc_kbd; env.drain_limit = 1u << 20;
+        pr_r0899_key_diagnostic kd;
+        st = pr_r0899_readkey_0059_cpu(MemBase, RAM, (pr_r0899_cpu *)&m, &env, &kd); site = kd.callee;
+        st = st == PR_R0899_KEY_RETURN ? 0 : st;
+    }
+    char tail[64]; snprintf(tail, sizeof tail, " [%u service calls]", (unsigned)svc.size());
+    if (st != 0) {
+        ++x.stops_seen; put(O); memcpy(MemBase, &oram[0], RAM);
+        char buf[128]; snprintf(buf, sizeof buf, "status %d site %04X%s%s; original result kept", st, site, refused.empty() ? "" : ", refused: ", refused.c_str());
+        line("C_STOPPED_SHADOW", (svc_mismatch.empty() ? std::string(buf) : svc_mismatch) + tail); close_window(); return true;
+    }
+    ++x.returned_seen;
+    if (svc_mismatch.empty() && svc_cursor != svc.size()) {
+        char buf[96]; snprintf(buf, sizeof buf, "C made %u of the original's %u service calls", (unsigned)svc_cursor, (unsigned)svc.size()); svc_mismatch = buf;
+    }
+    put(from14(S, m));
+    std::string d = diff(grab(), O, MemBase, &oram[0]);
+    if (svc_mismatch.empty() && d.empty()) { ++x.equal; line("SERVICES_REPLAYED_STATE_EQUAL", tail); }
+    else { ++x.differ; line(svc_mismatch.empty() ? "STATE_DIFF" : "SERVICE_DIFF", (svc_mismatch.empty() ? d : svc_mismatch) + tail); }
+    close_window(); return true;
+}
+/* V1 for a pr_bus body, at the original's return: the C runs on a replay bus from S; its device stream must equal the
+ * original's element by element, and its registers and RAM must equal O. The device already holds the original's effects
+ * (equal streams make them the C's too); on a C stop the original's result is kept. */
+static bool v1(const Regs &now) {
+    Body &x = bodies[cur];
+    O = now; memcpy(&oram[0], MemBase, RAM);
+    put(S); memcpy(MemBase, &sram[0], RAM);
+    cursor = 0; mismatch.clear();
+    pr_bus bus = {MemBase, &replay_ega, NULL, NULL, NULL};
+    Cpu14 m = to14(S);
+    int cls = run_bus(&bus, m);
+    if (cls != 0) {
+        ++x.stops_seen; put(O); memcpy(MemBase, &oram[0], RAM);
+        char buf[96]; snprintf(buf, sizeof buf, "class %d at %04X:%04X; original result kept", cls, m.cs, m.ip);
+        line("C_STOPPED_SHADOW", buf); close_window(); return true;
+    }
+    ++x.returned_seen;
+    if (mismatch.empty() && cursor != pr_rec::evs.size()) {
+        char buf[96]; snprintf(buf, sizeof buf, "C issued %u of the original's %u device events", (unsigned)cursor, (unsigned)pr_rec::evs.size());
+        mismatch = buf;
+    }
+    put(from14(S, m));
+    std::string d = diff(grab(), O, MemBase, &oram[0]);
+    char tail[64]; snprintf(tail, sizeof tail, " [%u device events]", (unsigned)pr_rec::evs.size());
+    if (mismatch.empty() && d.empty()) { ++x.equal; line("V1_STREAM_AND_STATE_EQUAL", tail); }
+    else { ++x.differ; line(mismatch.empty() ? "V1_STATE_DIFF" : "V1_STREAM_DIFF", (mismatch.empty() ? d : mismatch) + tail); }
+    close_window(); return true;
+}
+/* Before each instruction while a window is open. Returns true when CS:IP was changed (the caller reloads IP). */
+static bool step(void) {
+    Body &x = bodies[cur];
+    uint16_t c = SegValue(cs), ip = (uint16_t)reg_eip;
+    uint16_t rise = (uint16_t)(reg_sp - (uint16_t)S.esp);           /* pop 0: any RETF n (n <= 64) back to the caller */
+    if (c == ret_cs && ip == ret_ip && (x.pop ? reg_sp == sp_after : (rise >= 4u && rise <= 68u))) {
+        Regs now = grab();
+        pr_rec::on = false;
+        int_open = false;
+        interrupted = pr_hw_irqs != irq0;                     /* a hardware interrupt was taken inside the window */
+        if (interrupted) { ++x.interrupted; line("INTERRUPTED", "original result kept"); close_window(); return false; }
+        if (x.bus == 2) return svc_check(now);
+        if (x.bus) return v1(now);
+        if (state == RERUN || state == MIDBODY) {             /* the original finished: compare with the all-original O */
+            std::string d = diff(now, O, MemBase, &oram[0]);
+            if (state == RERUN) { if (d.empty()) ++x.back_equal; else ++x.back_differ; line(d.empty() ? "ARGUMENT_RERUN_EQUAL" : "ARGUMENT_RERUN_DIFF", d); }
+            else { if (d.empty()) ++x.mid_equal; else ++x.mid_differ; line(d.empty() ? "MIDBODY_HANDBACK_EQUAL" : "MIDBODY_HANDBACK_DIFF", d); }
+            close_window(); return false;
+        }
+        O = now; memcpy(&oram[0], MemBase, RAM);              /* state ORIGINAL: the all-original result */
+        put(S); memcpy(MemBase, &sram[0], RAM);               /* back to the entry state */
+        bool is0104 = !strcmp(x.id, "RES_0899_0104");
+        bool force_argument = is0104 && x.arrivals % 10u == 0u;
+        bool force_stop = !strcmp(x.id, "RES_0464_2595") && x.arrivals % 2u == 1u;
+        Cpu14 m = to14(S), before = m;
+        int cls = run_c(m, force_argument, force_stop);
+        if (cls == 1) {                                       /* ARGUMENT: nothing may change; the original reruns */
+            bool same = memcmp(&m, &before, sizeof m) == 0 && memcmp(MemBase, &sram[0], RAM) == 0;
+            line(same ? "ARGUMENT_NOTHING_CHANGED" : "ARGUMENT_CHANGED_STATE", force_argument ? "forced" : "unforced");
+            if (!same) ++x.back_differ;
+            state = RERUN; steps = 0; interrupted = false; irq0 = pr_hw_irqs; pr_obs::suppress_index = x.index; return true;
+        }
+        put(from14(S, m));                                    /* the C's state, complete or partial, is now the guest's */
+        if (cls == 0) {
+            ++x.returned_seen;
+            std::string d = diff(grab(), O, MemBase, &oram[0]);
+            if (d.empty()) ++x.equal; else ++x.differ;
+            line(d.empty() ? "C_EQUAL_ORIGINAL" : "C_DIFFERS", d); close_window(); return true;
+        }
+        ++x.stops_seen;                                       /* a stop: the original continues from the C's partial state */
+        char where[64]; snprintf(where, sizeof where, "stop at %04X:%04X%s", m.cs, m.ip, force_stop ? " (heap steps 0)" : "");
+        line("C_STOPPED_HANDING_BACK", std::string(where) + stop_bytes(m.cs, m.ip));
+        state = MIDBODY; steps = 0; interrupted = false; irq0 = pr_hw_irqs; return true;
+    }
+    if (x.bus == 2 && state == ORIGINAL) {                     /* record the original's INT 21h calls */
+        LinearPt here = SegPhys(cs) + ip;
+        if (int_open && c == int_ret_cs && ip == int_ret_ip && reg_sp == int_sp) {
+            SvcEv &e = svc.back(); e.after = to14(grab());
+            for (size_t k = 0; k < RAM; ++k) if (MemBase[k] != intram[k]) e.delta.push_back(std::make_pair((uint32_t)k, MemBase[k]));
+            int_open = false;
+        } else if (!int_open && mem_readb_inline(here) == 0xCD && (mem_readb_inline(here + 1u) == 0x21 || mem_readb_inline(here + 1u) == 0x16)) {
+            SvcEv e; e.before = to14(grab()); svc.push_back(e);
+            memcpy(&intram[0], MemBase, RAM); int_ret_cs = c; int_ret_ip = (uint16_t)(ip + 2u); int_sp = reg_sp; int_open = true;
+        }
+    }
+    if (++steps > 2000000u) { ++x.timeouts; line("TIMEOUT", "window abandoned"); close_window(); }
+    return false;
+}
+}  // namespace pr_disp
+
+/* The replay bus, linked in place of memory_bus.c: RAM is guest RAM; the VGA window and the ports are the V1 replay. */
+extern "C" {
+uint8_t pr_bus_read8(pr_bus *bus, size_t physical) {
+    physical &= 0xFFFFFu;
+    if (bus->ega != NULL && physical >= 0xA0000u && physical < 0xB0000u) {
+        if (pr_disp::bus_mode == 1) return mem_readb_inline((LinearPt)physical);          /* ROUTE: the real VGA, real latches */
+        uint32_t v = 0; pr_disp::expect('R', (uint32_t)physical, 0, 1, &v); return (uint8_t)v;
+    }
+    return bus->ram[physical];
+}
+void pr_bus_write8(pr_bus *bus, size_t physical, uint8_t value) {
+    physical &= 0xFFFFFu;
+    if (bus->ega != NULL && physical >= 0xA0000u && physical < 0xB0000u) {
+        if (pr_disp::bus_mode == 1) { mem_writeb_inline((LinearPt)physical, value); return; }
+        pr_disp::expect('W', (uint32_t)physical, value, 1, NULL); return;
+    }
+    bus->ram[physical] = value;
+}
+int pr_bus_out(pr_bus *bus, uint16_t port, uint16_t value, unsigned size, uint16_t cs, uint16_t ip) {
+    (void)bus; (void)cs; (void)ip;
+    if (pr_disp::bus_mode == 1) { if (size == 2) IO_WriteW(port, value); else IO_WriteB(port, (uint8_t)value); return 0; }
+    pr_disp::expect('O', port, value, size, NULL);
+    return 0;
+}
+}
+
+/* After the observer: in route mode, run a bus body's C before its first instruction executes. */
+#define PR_HYBRID_ROUTE() do { if (pr_disp::route_now && pr_disp::route()) { LOADIP; } } while (0)
+
+/* Before the observer, at each instruction start: advance an open window; reload IP when the dispatch moved CS:IP. */
+#define PR_HYBRID_STEP() do { if (pr_disp::state >= 2 && !cpu.pmode && pr_disp::step()) { LOADIP; } } while (0)
+#endif
