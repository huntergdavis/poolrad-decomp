+static bool route(void) {
+    Body &x = bodies[cur];
+    route_now = false;
+    Regs E = grab();
+    pr_bus bus = {MemBase, &replay_ega, NULL, NULL, NULL};
+    Cpu14 m = to14(E);
+    int cls = x.bus == 1 ? run_bus(&bus, m) : run_c(m, false, false);
+    if (cls == 1) { line("ROUTED_ARGUMENT", "nothing changed; the original runs"); cur = -1; return false; }
+    put(from14(E, m));
+    if (cls == 0) { ++x.returned_seen; ++routed_returned; }
+    else { ++x.stops_seen; ++routed_stops; char buf[64]; snprintf(buf, sizeof buf, "stop at %04X:%04X", m.cs, m.ip); line("ROUTED_STOP_HANDED_BACK", std::string(buf) + stop_bytes(m.cs, m.ip)); }
+    cur = -1; return true;
