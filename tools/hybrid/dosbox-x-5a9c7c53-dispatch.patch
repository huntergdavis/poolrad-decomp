diff --git a/src/cpu/pr_hybrid_record.h b/src/cpu/pr_hybrid_record.h
new file mode 100644
index 0000000..f880355
--- /dev/null
+++ b/src/cpu/pr_hybrid_record.h
@@ -0,0 +1,50 @@
+/* Poolrad hybrid executor: the DEVICE-STREAM RECORDER for V1 (docs/HYBRID_EGA_ADAPTER_SCOPE.md, VP i20594/i20637).
+ *
+ * While pr_rec::on, records, in execution order, every CPU access the guest makes to the VGA window A0000h..AFFFFh, as
+ * BYTE events ('R' with the value read, 'W' with the value written), and every port access ('O' out, 'I' in, with size).
+ * Word and dword accesses that touch the window are issued and recorded as byte accesses, low byte first: that is exactly
+ * how DOSBox-X's planar handlers split them (vga_memory.cpp do_read/do_write), so device behaviour is unchanged.
+ * Off (the default) costs one branch per memory access. Included by core_normal.cpp before its LoadMb..SaveMd macros. */
+#ifndef PR_HYBRID_RECORD_H
+#define PR_HYBRID_RECORD_H
+#include <cstdint>
+#include <vector>
+
+namespace pr_rec {
+struct Ev { char kind; uint32_t addr; uint32_t val; uint8_t size; };
+static bool on = false;
+static std::vector<Ev> evs;
+static inline bool vram(LinearPt a) { return a >= 0xA0000u && a < 0xB0000u; }
+static inline bool touches(LinearPt a, unsigned n) { return vram(a) || vram(a + n - 1u); }
+static void io(Bitu port, Bitu val, unsigned len, int is_read) {
+    if (on) { Ev e = {is_read ? 'I' : 'O', (uint32_t)port, (uint32_t)val, (uint8_t)len}; evs.push_back(e); }
+}
+}  // namespace pr_rec
+extern void (*pr_io_hook)(Bitu port, Bitu val, unsigned len, int is_read);   /* defined in iohandler.cpp */
+
+static INLINE uint8_t pr_lb(LinearPt a) {
+    uint8_t v = mem_readb_inline(a);
+    if (pr_rec::on && pr_rec::vram(a)) { pr_rec::Ev e = {'R', (uint32_t)a, v, 1}; pr_rec::evs.push_back(e); }
+    return v;
+}
+static INLINE void pr_sb(LinearPt a, uint8_t v) {
+    if (pr_rec::on && pr_rec::vram(a)) { pr_rec::Ev e = {'W', (uint32_t)a, v, 1}; pr_rec::evs.push_back(e); }
+    mem_writeb_inline(a, v);
+}
+static INLINE uint16_t pr_lw(LinearPt a) {
+    if (pr_rec::on && pr_rec::touches(a, 2)) { uint8_t lo = pr_lb(a); uint8_t hi = pr_lb(a + 1u); return (uint16_t)(lo | (hi << 8)); }
+    return mem_readw_inline(a);
+}
+static INLINE void pr_sw(LinearPt a, uint16_t v) {
+    if (pr_rec::on && pr_rec::touches(a, 2)) { pr_sb(a, (uint8_t)v); pr_sb(a + 1u, (uint8_t)(v >> 8)); return; }
+    mem_writew_inline(a, v);
+}
+static INLINE uint32_t pr_ld(LinearPt a) {
+    if (pr_rec::on && pr_rec::touches(a, 4)) { uint32_t lo = pr_lw(a); uint32_t hi = pr_lw(a + 2u); return lo | (hi << 16); }
+    return mem_readd_inline(a);
+}
+static INLINE void pr_sd(LinearPt a, uint32_t v) {
+    if (pr_rec::on && pr_rec::touches(a, 4)) { pr_sw(a, (uint16_t)v); pr_sw(a + 2u, (uint16_t)(v >> 16)); return; }
+    mem_writed_inline(a, v);
+}
+#endif
diff --git a/src/cpu/pr_hybrid_observer.h b/src/cpu/pr_hybrid_observer.h
new file mode 100644
index 0000000..d36b184
--- /dev/null
+++ b/src/cpu/pr_hybrid_observer.h
@@ -0,0 +1,154 @@
+/* Poolrad hybrid executor, STAGE 0: OBSERVER ONLY (docs/HYBRID_EXECUTOR_SCOPE.md in the poolrad-decomp repo, VP i20556).
+ *
+ * Counts arrivals at credited entry points. It never changes guest state: it reads guest bytes and writes host files.
+ * Inactive unless PR_HYBRID_REGISTRY names a registry (tools/hybrid/hybrid_registry.py output). An arrival is an
+ * instruction start, in real mode, whose IP equals a registry entry's offset and whose bytes at CS:IP equal that entry's
+ * signature with relocated words masked. Only signatures unique across all game code are used; the rest are listed as
+ * unobservable in the report.
+ *
+ * Output (PR_HYBRID_LOG, default pr_hybrid_observer): <log>.tsv (per-ID counts, first arrival) rewritten every 4096
+ * arrivals and at exit, and <log>.seq (every arrival in order, capped at SEQ_CAP lines; the cap is reported). */
+#ifndef PR_HYBRID_OBSERVER_H
+#define PR_HYBRID_OBSERVER_H
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <cstdint>
+#include <string>
+#include <vector>
+#include <sys/time.h>
+#include <sys/stat.h>
+
+namespace pr_obs {
+struct Entry {
+    std::string id;
+    uint16_t ip;
+    std::vector<uint8_t> sig, mask;
+    uint64_t count, first_insn;
+    uint16_t first_cs;
+};
+static int state = 0;                         /* 0 not loaded, 1 inactive, 2 active */
+static std::vector<Entry> entries;
+static std::vector<std::string> skipped;      /* registry rows whose signature is not unique */
+static std::vector<std::vector<int> > by_ip;  /* IP -> indexes into entries */
+static std::vector<uint8_t> hit;              /* IP -> nonzero when some entry has this IP */
+static uint64_t insns = 0, arrivals = 0, seq_lines = 0;
+static const uint64_t SEQ_CAP = 2000000;
+static std::string log_base;
+static FILE *seq = NULL;
+static FILE *draws = NULL;
+/* Seed-pin stage 2 (PM i22231): a TEST-HARNESS POKE, off unless PR_HYBRID_SEED_PIN is set. At the first RandSeed step (a DRAW_ row) after the
+ * driver has created <log>.pin (it does so at SAVE LOADED), DS:4428..442B := PR_HYBRID_SEED_PIN before the step runs. Logged in <log>.draws. */
+static int pin_state = 0;                     /* 0 off, 1 armed, 2 done */
+static uint32_t pin_value = 0;                    /* <log>.draws: every arrival of a DRAW_ row (the RandSeed step), never capped */
+static void (*on_match)(int index, uint16_t cs, uint16_t ip) = NULL;   /* set by the one-body dispatch */
+static int suppress_index = -1;               /* an entry whose re-arrival is a hand-back rerun, not a new arrival */
+
+static int hexval(char c) { return c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : c >= 'A' && c <= 'F' ? c - 'A' + 10 : -1; }
+static bool unhex(const std::string &s, std::vector<uint8_t> &out) {
+    if (s.size() % 2) return false;
+    out.clear();
+    for (size_t k = 0; k < s.size(); k += 2) {
+        int hi = hexval(s[k]), lo = hexval(s[k + 1]);
+        if (hi < 0 || lo < 0) return false;
+        out.push_back((uint8_t)(hi * 16 + lo));
+    }
+    return true;
+}
+
+static void report(void) {
+    if (state != 2) return;
+    std::string path = log_base + ".tsv";
+    FILE *f = fopen(path.c_str(), "w");
+    if (!f) return;
+    unsigned reached = 0;
+    for (size_t k = 0; k < entries.size(); ++k) if (entries[k].count) ++reached;
+    fprintf(f, "# stage0 observer: registry_unique=%u skipped_not_unique=%u reached=%u arrivals=%llu instructions=%llu seq_lines=%llu seq_cap=%llu\n",
+            (unsigned)entries.size(), (unsigned)skipped.size(), reached, (unsigned long long)arrivals, (unsigned long long)insns,
+            (unsigned long long)seq_lines, (unsigned long long)SEQ_CAP);
+    for (size_t k = 0; k < skipped.size(); ++k) fprintf(f, "#skipped\t%s\n", skipped[k].c_str());
+    fprintf(f, "# id\tarrivals\tfirst_instruction\tfirst_cs\n");
+    for (size_t k = 0; k < entries.size(); ++k)
+        fprintf(f, "%s\t%llu\t%llu\t%04X\n", entries[k].id.c_str(), (unsigned long long)entries[k].count,
+                (unsigned long long)entries[k].first_insn, entries[k].first_cs);
+    fclose(f);
+    if (seq) fflush(seq);
+}
+
+static void load(void) {
+    const char *reg = getenv("PR_HYBRID_REGISTRY");
+    state = 1;
+    if (!reg || !*reg) return;
+    FILE *f = fopen(reg, "r");
+    if (!f) { fprintf(stderr, "PR_HYBRID: cannot open registry %s\n", reg); return; }
+    by_ip.assign(65536, std::vector<int>()); hit.assign(65536, 0);
+    char line[4096];
+    while (fgets(line, sizeof line, f)) {
+        if (line[0] == '#') continue;
+        std::vector<std::string> col; std::string cur;
+        for (char *p = line; *p && *p != '\n'; ++p) { if (*p == '\t') { col.push_back(cur); cur.clear(); } else cur += *p; }
+        col.push_back(cur);
+        if (col.size() < 6) { if (!col.empty() && !col[0].empty()) skipped.push_back(col[0] + " (no signature)"); continue; }
+        if (col[5] != "unique") { skipped.push_back(col[0] + " (" + col[5] + ")"); continue; }
+        Entry e; e.id = col[0]; e.ip = (uint16_t)strtoul(col[1].c_str(), NULL, 16); e.count = 0; e.first_insn = 0; e.first_cs = 0;
+        if (!unhex(col[3], e.sig) || !unhex(col[4], e.mask) || e.sig.size() != e.mask.size() || e.sig.empty()) {
+            skipped.push_back(e.id + " (bad row)"); continue;
+        }
+        by_ip[e.ip].push_back((int)entries.size()); hit[e.ip] = 1; entries.push_back(e);
+    }
+    fclose(f);
+    const char *lb = getenv("PR_HYBRID_LOG");
+    log_base = lb && *lb ? lb : "pr_hybrid_observer";
+    seq = fopen((log_base + ".seq").c_str(), "w");
+    if (seq) fprintf(seq, "# n\tid\tcs:ip\tinstruction\n");
+    { const char *pv = getenv("PR_HYBRID_SEED_PIN"); if (pv && *pv) { pin_value = (uint32_t)strtoul(pv, NULL, 16); pin_state = 1; } }
+    draws = fopen((log_base + ".draws").c_str(), "w");
+    if (draws) { fprintf(draws, "# n\tinstruction\twall_ms\tcs:ip\trandseed_before (DS:4428, read at the step's entry)\n"); fflush(draws); }
+    state = 2;
+    atexit(report);
+    fprintf(stderr, "PR_HYBRID observer: %u entries, %u skipped\n", (unsigned)entries.size(), (unsigned)skipped.size());
+    report();
+}
+
+static void check(uint16_t cs, uint16_t ip, LinearPt base) {
+    const std::vector<int> &list = by_ip[ip];
+    for (size_t n = 0; n < list.size(); ++n) {
+        Entry &e = entries[list[n]];
+        size_t k = 0;
+        for (; k < e.sig.size(); ++k)
+            if (e.mask[k] && mem_readb_inline(base + (uint16_t)(ip + k)) != e.sig[k]) break;
+        if (k != e.sig.size()) continue;
+        if (on_match) on_match(list[n], cs, ip);
+        if (list[n] == suppress_index) continue;
+        if (!e.count) { e.first_insn = insns; e.first_cs = cs; }
+        ++e.count; ++arrivals;
+        if (seq && seq_lines < SEQ_CAP) { fprintf(seq, "%llu\t%s\t%04X:%04X\t%llu\n", (unsigned long long)arrivals, e.id.c_str(), cs, ip, (unsigned long long)insns); ++seq_lines; }
+        if (draws && e.id.compare(0, 5, "DRAW_") == 0) {
+            struct timeval tv; gettimeofday(&tv, NULL);
+            PhysPt d = SegPhys(ds) + 0x4428u;
+            if (pin_state == 1) {
+                struct stat st;
+                if (stat((log_base + ".pin").c_str(), &st) == 0) {
+                    for (int k = 0; k < 4; ++k) mem_writeb(d + k, (uint8_t)(pin_value >> (8 * k)));
+                    pin_state = 2;
+                    fprintf(draws, "# PINNED RandSeed := %08X at draw %llu, instruction %llu\n", pin_value, (unsigned long long)e.count, (unsigned long long)insns);
+                }
+            }
+            uint32_t seed = (uint32_t)mem_readb_inline(d) | ((uint32_t)mem_readb_inline(d + 1) << 8) |
+                            ((uint32_t)mem_readb_inline(d + 2) << 16) | ((uint32_t)mem_readb_inline(d + 3) << 24);
+            fprintf(draws, "%llu\t%llu\t%llu\t%04X:%04X\t%08X\n", (unsigned long long)e.count, (unsigned long long)insns,
+                    (unsigned long long)tv.tv_sec * 1000ull + (unsigned long long)(tv.tv_usec / 1000), cs, ip, seed);
+            fflush(draws);
+        }
+        if (draws && e.id.compare(0, 7, "SAMPLE_") == 0)            /* a sampled return (e.g. GetMem's success RETF): DX:AX at that instruction */
+            { fprintf(draws, "# SAMPLE %s %llu DX:AX=%04X:%04X\n", e.id.c_str(), (unsigned long long)e.count, (unsigned)reg_dx, (unsigned)reg_ax); fflush(draws); }
+        if ((arrivals & 4095u) == 0) report();
+    }
+}
+}  // namespace pr_obs
+
+/* At each instruction start: count it, and on an IP hit compare the signature. Real mode only. */
+#define PR_HYBRID_OBSERVE() do { \
+    if (pr_obs::state == 2 && !cpu.pmode) { ++pr_obs::insns; \
+        if (pr_obs::hit[(uint16_t)reg_eip]) pr_obs::check(SegValue(cs), (uint16_t)reg_eip, SegPhys(cs)); } } while (0)
+#endif
diff --git a/src/cpu/pr_hybrid_dispatch.h b/src/cpu/pr_hybrid_dispatch.h
new file mode 100644
index 0000000..cd81151
--- /dev/null
+++ b/src/cpu/pr_hybrid_dispatch.h
@@ -0,0 +1,1193 @@
+/* Poolrad hybrid executor: per-body DISPATCH with an in-run check (VP i20596, i20618). Included after pr_hybrid_observer.h.
+ *
+ * Enabled by PR_HYBRID_DISPATCH, a comma-separated list of the bodies this file knows: RES_0899_0104, RES_0464_2595.
+ * At each arrival of a listed body (the observer's signature match):
+ *   1. snapshot S: the 32-bit registers, segments, flags and guest RAM 0..1 MiB (MemBase);
+ *   2. the ORIGINAL bytes run to the body's own return (CS:IP = the far return address on the stack, SP = entry SP + the
+ *      body's RETF pop); its state is O. Any instruction outside the body's allowed code segments before that return
+ *      (an interrupt) marks the arrival INTERRUPTED and O stands. A 200,000-instruction budget bounds the window;
+ *   3. S is restored and OUR C runs on the live guest (registers copied in, guest RAM as the model's 1 MiB, registers
+ *      copied out). Then:
+ *      - RETURNED: the game continues from the C's state, which is compared with O in full (C_EQUAL_ORIGINAL);
+ *      - a STOP (any other status but ARGUMENT): the C's partial state is written to the guest and the ORIGINAL bytes
+ *        continue from it: a MID-BODY HAND-BACK. At the body's return the live state is compared with O in full;
+ *      - ARGUMENT (forced, 0104 only, every 10th arrival): must change nothing; the original runs again from S and must
+ *        reproduce O.
+ * Per body: 0104 RETF (pop 4), allowed CS = its own; 2595 RETF 4 (pop 8), allowed CS = its own and SYSTEM, odd arrivals
+ * get max_heap_steps 0 (FreeMem stops LIMIT at 0AF8:040F when its walk loops; 2595 reports CALLEE), even arrivals 65535.
+ * Log: <PR_HYBRID_LOG>.dispatch, one line per arrival, and a summary line per body at exit. */
+#ifndef PR_HYBRID_DISPATCH_H
+#define PR_HYBRID_DISPATCH_H
+#include <cstddef>
+extern "C" {
+#include "poolrad/recovered/resident_0899_idle_0104_cpu.h"
+#include "poolrad/recovered/resident_0464_bitmap_release_2595_cpu.h"
+#include "poolrad/recovered/resident_0709_glyph_01df_cpu.h"
+#include "poolrad/recovered/resident_0709_space_05eb_cpu.h"
+#include "poolrad/recovered/resident_0709_printer_0626_cpu.h"
+#include "poolrad/recovered/resident_03f1_clear_0137_cpu.h"
+#include "poolrad/recovered/overlay_u3b0_entry_01da_cpu.h"
+#include "poolrad/recovered/overlay_u86_procvars_3413.h"
+#include "poolrad/recovered/overlay_u38_effects_install_31a2.h"
+#include "poolrad/recovered/overlay_u3b0_item_split_00cb_cpu.h"
+#include "poolrad/recovered/resident_0802_02eb_cpu.h"
+#include "poolrad/recovered/resident_0899_readkey_0059_cpu.h"
+#include "poolrad/recovered/resident_0802_025d_cpu.h"
+#include "poolrad/recovered/resident_0802_050f_cpu.h"
+#include "poolrad/recovered/resident_0802_05cd_cpu.h"
+#include "poolrad/recovered/resident_0802_06e7_cpu.h"
+#include "poolrad/recovered/overlay_u25_slot_value_0136.h"
+#include "poolrad/recovered/overlay_u25_loader_0000.h"
+#include "poolrad/recovered/overlay_u25_load_word_0e0c.h"
+#include "poolrad/recovered/resident_00ba_byte_string_1037_cpu.h"
+#include "poolrad/recovered/overlay_u1c_if_0b52.h"
+#include "poolrad/recovered/overlay_u6f_vector_merge_032f.h"
+#include "poolrad/recovered/resident_00ba_display_1816_cpu.h"
+#include "poolrad/recovered/overlay_u25_skip_1ea6.h"
+#include "poolrad/recovered/resident_0802_0716_cpu.h"
+#include "poolrad/recovered/resident_0802_0716_composed_cpu.h"
+#include "poolrad/recovered/overlay_u6f_party_insert_1446_cpu.h"
+#include "poolrad/recovered/overlay_u9b_entry_zero_0000.h"
+#include "poolrad/recovered/overlay_u9b_record_table_0255.h"
