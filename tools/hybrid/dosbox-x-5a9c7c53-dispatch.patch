+        if (routing && skip && strstr(skip, bodies[b].id)) { fprintf(stderr, "PR_HYBRID dispatch: %s skipped in route\n", bodies[b].id); continue; }
+        for (size_t k = 0; k < pr_obs::entries.size(); ++k) if (pr_obs::entries[k].id == bodies[b].id) bodies[b].index = (int)k;
