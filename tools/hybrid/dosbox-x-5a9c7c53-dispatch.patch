+static void expect(char kind, uint32_t addr, uint32_t val, unsigned size, uint32_t *read_value) {
+    if (!mismatch.empty()) { if (read_value) *read_value = 0; return; }
+    char buf[160];
+    if (cursor >= pr_rec::evs.size()) {
+        snprintf(buf, sizeof buf, "event %u: C %c %05X=%X/%u beyond the original's %u events", (unsigned)cursor, kind, (unsigned)addr,
+                 (unsigned)val, size, (unsigned)pr_rec::evs.size());
+        mismatch = buf; if (read_value) *read_value = 0; return;
+    }
+    const pr_rec::Ev &e = pr_rec::evs[cursor];
+    bool ok = e.kind == kind && e.addr == addr && e.size == size && (kind == 'R' || e.val == val);
+    if (!ok) {
+        snprintf(buf, sizeof buf, "event %u: C %c %05X=%X/%u, original %c %05X=%X/%u", (unsigned)cursor, kind, (unsigned)addr, (unsigned)val,
